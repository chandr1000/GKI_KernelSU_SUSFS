--- a/_setup_env.sh
+++ b/_setup_env.sh
@@ -93,8 +93,21 @@
   export SOURCE_DATE_EPOCH=0
 fi
 export KBUILD_BUILD_TIMESTAMP="$(date -d @${SOURCE_DATE_EPOCH})"
-export KBUILD_BUILD_HOST=build-host
-export KBUILD_BUILD_USER=build-user
+# WILD_BRANDING_PATCHED: prefer .wild_build_host/.wild_build_user files, then
+# env, then defaults. ROOT_DIR and KERNEL_DIR are set earlier in this script.
+# The files are written by apply-kernel-branding/action.yml to
+# ${ROOT_DIR}/${KERNEL_DIR}/ and survive into the bazel sandbox, where
+# --action_env may not reach the KernelEnv action.
+if [ -f "${ROOT_DIR}/${KERNEL_DIR}/.wild_build_host" ]; then
+  export KBUILD_BUILD_HOST=$(cat "${ROOT_DIR}/${KERNEL_DIR}/.wild_build_host")
+else
+  [ -n "${KBUILD_BUILD_HOST:-}" ] || export KBUILD_BUILD_HOST=build-host
+fi
+if [ -f "${ROOT_DIR}/${KERNEL_DIR}/.wild_build_user" ]; then
+  export KBUILD_BUILD_USER=$(cat "${ROOT_DIR}/${KERNEL_DIR}/.wild_build_user")
+else
+  [ -n "${KBUILD_BUILD_USER:-}" ] || export KBUILD_BUILD_USER=build-user
+fi
 export KBUILD_BUILD_VERSION=1

 # List of prebuilt directories shell variables to incorporate into PATH
